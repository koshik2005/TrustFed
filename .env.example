# ==============================================================================
# TrustFed AI — Unified Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development or set these variables
# in the Render (Backend) and Vercel (Frontend) service dashboards.
# DO NOT COMMIT PRODUCTION SECRETS OR CRYPTOGRAPHIC KEYS TO SOURCE CONTROL.

# ------------------------------------------------------------------------------
# 1. Deployment Mode & Environment
# ------------------------------------------------------------------------------
# Primary deployment mode:
# - 'informational' (DEFAULT): Educational decision support only. Synthetic & public data.
#   No patient names/contacts collected. Doctor confirmation and FL training disabled.
# - 'clinical' (REQUIRES ENTERPRISE PREREQUISITES): Multi-tenant hospital workflow,
#   attending physician confirmation, and differential privacy federated learning.
#   Backend REFUSES to start in clinical mode unless enterprise flags below are confirmed.
APP_MODE=informational

# Set to 'production' in deployed environments to enforce HTTPS, HSTS, secure cookies,
# and disable development auto-reloads.
ENVIRONMENT=development

# When 'false', demo 1-click accounts and mock credentials are disabled.
# In clinical mode, this MUST be set to 'false'.
ALLOW_DEMO_USERS=true

# Initial password for newly seeded demo accounts in development/demo mode.
DEMO_PASSWORD=password123

# Rate limiting controls
DISABLE_RATE_LIMIT=false
RATE_LIMIT_DEFAULT=120/minute

# ------------------------------------------------------------------------------
# 1b. Clinical Mode Enterprise Prerequisites (Required only when APP_MODE=clinical)
# ------------------------------------------------------------------------------
# Confirms that the target database is a managed cluster with verified automated daily/PITR backups.
MANAGED_DB_BACKUPS_CONFIRMED=false

# Enforces Multi-Factor Authentication across all clinical accounts.
MFA_REQUIRED=false

# Confirms that PATIENT_ENCRYPTION_KEY is managed via an enterprise secrets store (AWS KMS, Render Secrets, Vault).
SECRETS_STORE_MANAGED=false

# ------------------------------------------------------------------------------
# 2. Authentication, JWT & Security Cryptography (Key Rotation Enabled)
# ------------------------------------------------------------------------------
# Cryptographic secret used for signing JWT access tokens (15m expiry) and refresh tokens (7d).
# Generate a strong 64-character random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-secure-random-64-character-hex-string
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string

# Key ID (kid) for the active JWT signing key
JWT_ACTIVE_KID=v1

# Multi-key keyring for seamless JWT rotation without user disruption:
# Accepts JSON map `{"v2": "new_secret", "v1": "old_secret"}` or comma-separated pairs `v2:new_secret,v1:old_secret`
JWT_KEY_RING=v1:replace-with-a-secure-random-64-character-hex-string

# Symmetric 32-byte URL-safe base64 key for AES-128 Fernet encryption of direct PHI at rest.
# Supports MultiFernet key rotation: provide comma-separated keys (`primary_key,secondary_key`).
# Generate via: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
PATIENT_ENCRYPTION_KEY=replace-with-fernet-key-32-byte-base64

# SameSite policy for the httpOnly refresh token cookie: 'Lax' (recommended with Vercel rewrite) or 'None' (if cross-site).
COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# 3. Database Connection & Connection Pooling
# ------------------------------------------------------------------------------
# Managed PostgreSQL connection URI (e.g. Supabase, Neon, AWS RDS, or Render PostgreSQL).
# Recommended: Supabase IPv4 Pooler in South Asia Mumbai (`ap-south-1`) or `ap-northeast-2`.
# If left blank, the backend falls back to local SQLite database at `trustfed.db`.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Production Connection Pool Parameters
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 4. CORS & Network Ingress
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# Must include your production Vercel frontend URL and local dev ports.
CORS_ORIGINS=https://frontend-3qgo.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Public API URL passed to the frontend at build time.
# In production with Vercel rewrites, leave blank or set to '/api' for first-party cookie handling.
VITE_API_URL=https://trustfed-backend.onrender.com

# ------------------------------------------------------------------------------
# 6. Optional Clinical LLM & Sentry Monitoring
# ------------------------------------------------------------------------------
# Optional NVIDIA NIM API key for generating enriched clinical explanations.
# If omitted, the engine uses deterministic clinical rule-based explanations.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Sentry DSN for error telemetry (all patient identifiers and tokens scrubbed before send).
SENTRY_DSN=
